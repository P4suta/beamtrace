{
	"name": "beamtrace-acceptance",
	"private": true,
	"scripts": {
		"test:e2e": "playwright test",
		"test:mcp": "node --test tests/mcp/*.test.mjs",
		"test:property": "node --test tests/property/*.test.js",
		"test:release-credentials": "tsc --noEmit --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --target ES2023 --module NodeNext --types node scripts/release-credential-contract.test.mts && node --test scripts/release-credential-contract.test.mts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@modelcontextprotocol/client": "2.4.0",
		"@playwright/test": "1.65.0",
		"@types/node": "24.19.2",
		"bun": "1.4.4",
		"fast-check": "4.10.2",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	}
}
