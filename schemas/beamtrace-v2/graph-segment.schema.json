{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beamtrace.dev/schema/v2/graph-segment.schema.json",
  "title": "BeamTrace v2 graph segment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_ids", "edges", "boundaries"],
  "properties": {
    "schema_version": {"const": 2},
    "event_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "edges": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/edge"}},
    "boundaries": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/boundary"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$"},
    "safe_nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "serial": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "previous", "current"], "properties": {"kind": {"const": "sequence"}, "previous": {"$ref": "#/$defs/safe_nonnegative"}, "current": {"$ref": "#/$defs/safe_nonnegative"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "current"], "properties": {"kind": {"const": "legacy"}, "current": {"$ref": "#/$defs/safe_nonnegative"}}}
      ]
    },
    "inference_input": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"const": "event"}, "id": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "name", "value"], "properties": {"kind": {"enum": ["observation", "setting"]}, "name": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"type": "string", "minLength": 1, "maxLength": 2048}}}
      ]
    },
    "evidence": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "exact"}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "inference"],
          "properties": {
            "kind": {"const": "inferred"},
            "inference": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "reason", "inputs"],
              "properties": {
                "method": {"type": "string", "minLength": 1, "maxLength": 128},
                "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
                "inputs": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/inference_input"}}
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "evidence"],
      "properties": {
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/edge_kind"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "kind", "reason"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/edge_kind"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "edge_kind": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "serial"], "properties": {"kind": {"const": "sequential_message"}, "serial": {"$ref": "#/$defs/serial"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["process_order", "spawned", "link_relationship", "external_boundary", "unobserved_state"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": {"kind": {"const": "inferred_relation"}, "reason": {"type": "string", "minLength": 1, "maxLength": 2048}}}
      ]
    }
  }
}
