{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beamtrace.dev/schema/v2/index.schema.json",
  "title": "BeamTrace v2 event index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "segments"],
  "properties": {
    "schema_version": {"const": 2},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9995,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "first", "count"],
        "properties": {
          "path": {"type": "string", "pattern": "^events/[0-9]{6}\\.ndjson$"},
          "first": {"type": "integer", "minimum": 0},
          "count": {"type": "integer", "minimum": 0, "maximum": 1000}
        }
      }
    }
  }
}
