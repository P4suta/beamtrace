{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beamtrace.dev/schema/v2/manifest.schema.json",
  "title": "BeamTrace v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "capture_id", "nodes", "outcome", "privacy"],
  "properties": {
    "schema_version": {"const": 2},
    "tool_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "capture_id": {"$ref": "#/$defs/id"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/node"}
    },
    "outcome": {"$ref": "#/$defs/outcome"},
    "privacy": {"$ref": "#/$defs/privacy"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$"},
    "node": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[^@\\u0000]+@[^@\\u0000]+$"},
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive_duration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end", "issues", "receipts"],
      "properties": {
        "end": {"$ref": "#/$defs/end"},
        "issues": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/issue"}},
        "receipts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/receipt"}}
      }
    },
    "end": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "quiet_ms"], "properties": {"kind": {"const": "quiet_period"}, "quiet_ms": {"$ref": "#/$defs/positive_duration"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "window_ms"], "properties": {"kind": {"const": "time_window"}, "window_ms": {"$ref": "#/$defs/positive_duration"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "user_stopped"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "budget"], "properties": {"kind": {"const": "budget_reached"}, "budget": {"type": "string", "minLength": 1, "maxLength": 128}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "node", "reason"], "properties": {"kind": {"const": "agent_failure"}, "node": {"$ref": "#/$defs/node"}, "reason": {"type": "string", "minLength": 1, "maxLength": 1024}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "legacy_unknown"}}}
      ]
    },
    "issue": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "node", "count"], "properties": {"kind": {"const": "dropped_events"}, "node": {"$ref": "#/$defs/node"}, "count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "node"], "properties": {"kind": {"const": "missing_node"}, "node": {"$ref": "#/$defs/node"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "node", "expected", "actual"], "properties": {"kind": {"const": "batch_sequence_gap"}, "node": {"$ref": "#/$defs/node"}, "expected": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "actual": {"$ref": "#/$defs/nonnegative"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "node", "sequence"], "properties": {"kind": {"const": "duplicate_batch"}, "node": {"$ref": "#/$defs/node"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "node", "field", "expected", "actual"], "properties": {"kind": {"const": "receipt_mismatch"}, "node": {"$ref": "#/$defs/node"}, "field": {"enum": ["final_batch_sequence", "event_count", "byte_count"]}, "expected": {"$ref": "#/$defs/nonnegative"}, "actual": {"$ref": "#/$defs/nonnegative"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "node", "timeout_ms"], "properties": {"kind": {"const": "drain_timeout"}, "node": {"$ref": "#/$defs/node"}, "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": {"kind": {"const": "legacy_unverified"}, "reason": {"type": "string", "minLength": 1, "maxLength": 2048}}}
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "final_batch_sequence", "event_count", "byte_count"],
      "properties": {
        "node": {"$ref": "#/$defs/node"},
        "final_batch_sequence": {"$ref": "#/$defs/nonnegative"},
        "event_count": {"$ref": "#/$defs/nonnegative"},
        "byte_count": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "privacy": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "metadata"}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "redact_keys", "max_depth", "max_binary_bytes"],
          "properties": {
            "kind": {"const": "raw"},
            "redact_keys": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
            "max_depth": {"type": "integer", "minimum": 1, "maximum": 32},
            "max_binary_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
          }
        }
      ]
    }
  }
}
